{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genes.pietri.dev/schemas/common.v1.json",
  "title": "genes: shared definitions",
  "$defs": {
    "species_id": {
      "description": "Stable slug of the accepted scientific name on the day the species was created; never changes (spec §4.1). Ids starting with example- are demonstration species, valid only under examples/.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": { "type": "integer", "minimum": 1 },
    "month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "source_ids": {
      "description": "Ids of entries in the sheet's sources[] (spec §5.1).",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "range": {
      "description": "A numeric fact in real units, the unit in the field name: what sources say a healthy adult reaches in its range (spec §5.1). min ≤ typical ≤ max is checked by the validator.",
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "typical": { "type": "number" },
        "max": { "type": "number" },
        "source": { "$ref": "#/$defs/source_ids" },
        "note": { "type": "string" }
      },
      "required": ["min", "max", "source"],
      "additionalProperties": false
    },
    "level": {
      "description": "A sourced qualitative fact.",
      "type": "object",
      "properties": {
        "value": { "enum": ["none", "low", "medium", "high"] },
        "source": { "$ref": "#/$defs/source_ids" },
        "note": { "type": "string" }
      },
      "required": ["value", "source"],
      "additionalProperties": false
    },
    "phase": {
      "description": "A yearly phase: its usual months and, where known, what triggers it (spec §5.1).",
      "type": "object",
      "properties": {
        "months": {
          "type": "array",
          "items": { "$ref": "#/$defs/month" },
          "minItems": 1,
          "uniqueItems": true
        },
        "trigger": {
          "enum": ["first_spring_rains", "first_frost", "day_length", "heat_sum", "rain", "drought"]
        },
        "source": { "$ref": "#/$defs/source_ids" },
        "note": { "type": "string" }
      },
      "required": ["months", "source"],
      "additionalProperties": false
    },
    "colour": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "tones": {
      "description": "One lit and one shade colour, at most one accent (spec §6.4; painted spec §3.1).",
      "type": "object",
      "properties": {
        "lit": { "$ref": "#/$defs/colour" },
        "shade": { "$ref": "#/$defs/colour" },
        "accent": { "$ref": "#/$defs/colour" }
      },
      "required": ["lit", "shade"],
      "additionalProperties": false
    },
    "localised": {
      "type": "object",
      "properties": { "es": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } },
      "required": ["es", "en"],
      "additionalProperties": false
    },
    "names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
